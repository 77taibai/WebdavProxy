# WebDAV 代理配置示例
# 用法：复制为 .env（放在工作目录），或直接在 SaaS 平台上注入同名环境变量。
# 注意：真实环境变量优先于 .env 文件中的同名变量。

# ========= 必填 =========

# 上游 WebDAV 基地址（代理把所有请求转发到这里）
# 示例：https://dav.example.com/dav/
UPSTREAM_URL=https://dav.example.com/dav/

# 客户端访问代理时使用的 Basic 认证凭据（不是上游凭据，二者相互隔离）
PROXY_USER=change-me
PROXY_PASSWORD=change-me

# ========= 可选 =========

# 上游的 Basic 认证凭据；上游无需认证时留空。
# 留空时代理不向上游发送 Authorization 头。
UPSTREAM_USER=
UPSTREAM_PASSWORD=

# 只读模式：true/1/yes（不区分大小写）时启用。
# 启用后 PUT/DELETE/MKCOL/COPY/MOVE/PROPPATCH/LOCK/UNLOCK/POST 一律返回 403，不会被转发。
READ_ONLY=false

# 监听地址与端口。容器内用默认 0.0.0.0；本地运行建议 127.0.0.1。
HOST=0.0.0.0
PORT=8080
